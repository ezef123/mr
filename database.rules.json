{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','username','usernameLower','displayName','createdAt'])",
        "uid":           { ".validate": "newData.val() === $uid" },
        "username":      { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20" },
        "usernameLower": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20" },
        "displayName":   { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
        "bio":           { ".validate": "newData.isString() && newData.val().length <= 300" },
        "avatar":        { ".validate": "newData.isString() && newData.val().length <= 500" },
        "createdAt":     { ".validate": "newData.isNumber()" },
        "following": {
          "$followedUid": {
            ".validate": "newData.isBoolean() && root.child('users').child($followedUid).exists()"
          }
        }
      }
    },

    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && root.child('users').child(newData.val()).child('usernameLower').val() === $username"
      }
    },

    "posts": {
      ".read": true,
      ".indexOn": ["createdAt", "author"],
      "$postId": {
        ".write": "auth != null && (data.exists() ? data.child('author').val() === auth.uid : newData.child('author').val() === auth.uid)",
        "id":        { ".validate": "newData.val() === $postId" },
        "author":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "text":      { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "image":     { ".validate": "newData.isString() && newData.val().length <= 500" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && (!data.exists() || data.child('author').val() === auth.uid)",
            "id":        { ".validate": "newData.val() === $commentId" },
            "author":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "text":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "createdAt": { ".validate": "newData.isNumber()" }
          }
        }
      }
    }
  }
}
